#
# Template for the Doxygen configuration. CMake turns this into
# <build_tree>/docs/Doxyfile by substituting the @VARIABLES@ below, so do not
# run Doxygen on this file directly.
#
# This lists the tags this project cares about, not a full Doxyfile; anything
# absent keeps whatever default the installed Doxygen ships with. Some tags
# below do currently match their default -- they are spelled out because
# Doxygen changes defaults between releases and these should not drift.
# `doxygen -x <build_tree>/docs/Doxyfile` prints the effective difference from
# the defaults of the installed version.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIR@"
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
# include/ comes first: it is the API an embedding host writes against, and
# the only part of the tree that is a contract rather than an implementation.
INPUT                  = "@PROJECT_SOURCE_DIR@/include" \
                         "@PROJECT_SOURCE_DIR@/src" \
                         "@PROJECT_SOURCE_DIR@/README.md" \
                         "@PROJECT_SOURCE_DIR@/CONTRIBUTING.md" \
                         "@PROJECT_SOURCE_DIR@/CHANGELOG.md"
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.cc *.cpp *.h *.hpp *.md
EXCLUDE_PATTERNS       = */build/* */.git/*
INPUT_ENCODING         = UTF-8

# Show paths relative to the repository root rather than absolute ones.
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@PROJECT_SOURCE_DIR@/include" \
                         "@PROJECT_SOURCE_DIR@/src"

#---------------------------------------------------------------------------
# What gets extracted
#---------------------------------------------------------------------------
# YES so that the not-yet-documented parts of the code still show up in the
# file and class lists. Flip to NO once the codebase is documented throughout
# and you want undocumented entities to be invisible rather than bare.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

#---------------------------------------------------------------------------
# Comment style
#---------------------------------------------------------------------------
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
USE_MDFILE_AS_MAINPAGE = "@PROJECT_SOURCE_DIR@/README.md"
TAB_SIZE               = 4
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = "@PROJECT_SOURCE_DIR@/src"
# Document the OpenMP-guarded branches as if OpenMP were available.
PREDEFINED             = _OPENMP \
                         ARMA_USE_OPENMP

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
# Flags @param names that do not match the signature -- the main way doc
# comments rot. Undocumented entities are not warned about; EXTRACT_ALL
# suppresses that anyway while the codebase is only partly documented.
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = TOGGLE
SEARCHENGINE           = YES

#---------------------------------------------------------------------------
# Formulas
#---------------------------------------------------------------------------
# MathJax renders \f$...\f$ and \f[...\f] in the browser, so no LaTeX
# installation is required to build the docs. It does need network access when
# the pages are opened; set USE_MATHJAX to NO and install a LaTeX distribution
# if the documentation has to work offline.
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_FORMAT         = HTML-CSS

#---------------------------------------------------------------------------
# Other output formats
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Graphs (only used when Graphviz is installed; CMake fills HAVE_DOT in)
#---------------------------------------------------------------------------
HAVE_DOT               = @DOXYGEN_HAVE_DOT@
# Empty when Graphviz was not found, in which case HAVE_DOT is NO anyway.
DOT_PATH               = "@DOXYGEN_DOT_PATH@"
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_GRAPH_MAX_NODES    = 100

#---------------------------------------------------------------------------
# Source browser
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = NO
VERBATIM_HEADERS       = YES
