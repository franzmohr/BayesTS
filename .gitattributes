# Line endings.
#
# Normalise to LF in the repository and check out whatever is native to the
# platform. This has to be in place for the first commit: applying it later
# rewrites every line of every file, which turns one commit into a diff nobody
# can review and breaks `git blame` across it.
* text=auto

# Spelled out per type as well, so the result does not depend on git's content
# heuristic guessing right about a file it has not seen before.
*.cpp   text diff=cpp
*.h     text diff=cpp
*.md    text diff=markdown
*.txt   text
*.json  text
*.in    text
*.cmake text
.gitattributes text
.gitignore     text

# Shell scripts keep LF whatever the platform: they are run by MSYS2, WSL or a
# POSIX shell, none of which tolerate CRLF in a shebang.
*.sh text eol=lf

# Batch files are the mirror image.
*.bat text eol=crlf
*.cmd text eol=crlf

# Model files and sampler output. Never normalised, never diffed as text. None
# should be committed at all -- .gitignore covers them -- but a binary marker
# means a stray one cannot be silently corrupted by newline translation.
*.h5   binary
*.hdf5 binary

# Kept out of the archives GitHub generates for a release: they configure the
# working repository and mean nothing in an unpacked source tree.
.gitattributes export-ignore
.gitignore     export-ignore
